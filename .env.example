# ==============================================================================
# ScamShield AI - Production Environment Variables
# ==============================================================================
# Copy this file to .env for local development or enter these in Vercel Project Settings:
# https://vercel.com/<your-team>/<your-project>/settings/environment-variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with connection pooler (Session or Transaction pooler on port 5432/6543)
DATABASE_URL=postgresql://postgres.braqdveiscllhubnmaqa:Parth%4007091705@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Project API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://braqdveiscllhubnmaqa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_smnRe-WzTPbS4l2-1CxYpQ_ZrAMn29u

# Frontend equivalents for Vite
VITE_SUPABASE_URL=https://braqdveiscllhubnmaqa.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_smnRe-WzTPbS4l2-1CxYpQ_ZrAMn29u

# ------------------------------------------------------------------------------
# 2. AI MODEL CONFIGURATION (Google Gemini API)
# ------------------------------------------------------------------------------
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Recommended: gemini-2.5-flash or gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 3. BACKEND & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Secret keys for signing cookies/tokens
SECRET_KEY=change-this-to-a-secure-random-32-char-string-in-production
JWT_SECRET_KEY=change-this-to-another-secure-random-32-char-string

# Allowed CORS Origins (Comma-separated). In production on Vercel, requests to /api are same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional Google Safe Browsing API Key (Leave empty to use built-in URL heuristics)
SAFE_BROWSING_API_KEY=

# ------------------------------------------------------------------------------
# 4. FRONTEND API ROUTING
# ------------------------------------------------------------------------------
# In production on Vercel, leave VITE_API_BASE_URL empty so requests route to same-domain /api
# In local development, defaults automatically to http://127.0.0.1:5000
VITE_API_BASE_URL=
